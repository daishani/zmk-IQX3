#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        taptap: taptap {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <150>;
        };

        holdhold: holdhold {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDHOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <150>;
            flavor = "tap-unless-interrupted";
            retro-tap;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        KEY: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(C) &kp H &kp L &kp DOT &kp N8 &kp N8 &kp N0 &kp N6 &kp N0 &kp N2 &kp EXCL &kp AT &kp POUND &kp DLLR &kp PRCNT &kp CARET &kp ENTER>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
  &lt 3 Q          &kp W  &kp E              &kp R               &kp T        &kp Y                  &kp U        &kp I        &kp O    &kp P
  &kp A            &kp S  &kp D              &kp F               &kp G        &kp H                  &kp J        &kp K        &kp L    &kp SLASH
  &taptap LCTRL Z  &kp X  &kp C              &kp V               &kp B        &kp N                  &kp M        &kp COMMA    &kp DOT  &mt RSHFT PG_DN
                          &mt LALT CAPSLOCK  &mt LEFT_SHIFT TAB  &lt 1 SPACE  &holdhold 1 BACKSPACE  &lt 2 ENTER  &lt 3 PG_UP
            >;
        };

        Number {
            label = "Number";
            bindings = <
  &kp ESC    &kp N1  &kp N2    &kp N3     &kp KP_DOT     &kp Y              &kp U            &kp MINUS  &kp EQUAL  &kp GRAVE
  &kp LSHFT  &kp N4  &kp N5    &kp N6     &kp N0         &kp H              &kp LEFT_SHIFT   &kp LBKT   &kp RBKT   &kp BSLH
  &kp LGUI   &kp N7  &kp N8    &kp N9     &kp BACKSPACE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp SEMI   &kp APOS   &kp DEL
                     &kp LALT  &kp LCTRL  &kp SPACE      &kp BSPC           &kp ENTER        &trans
            >;
        };

        Icons {
            label = "Icons";
            bindings = <
  &kp ESC         &mmv MOVE_UP    &mkp MB4         &mkp MB5            &trans    &kp Y    &kp PG_DN  &kp UP     &kp PG_UP  &kp DEL
  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP        &trans    &kp END  &kp LEFT   &kp DOWN   &kp RIGHT  &kp HOME
  &kp LCTRL       &mkp MB3        &mkp MB2         &msc SCRL_DOWN      &trans    &kp N    &kp M      &kp COMMA  &kp DOT    &kp RCTRL
                                  &kp LALT         &mt LEFT_SHIFT TAB  &mkp MB1  &trans   &trans     &kp LALT
            >;
        };

        Ble {
            label = "Ble";
            bindings = <
  &kp ESC    &kp F1  &kp F2    &kp F3   &kp F4     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
  &kp LSHFT  &kp F5  &kp F6    &kp F7   &kp F8     &trans        &trans        &trans        &bt BT_CLR    &out OUT_TOG
  &kp LCTRL  &kp F9  &kp F10   &kp F11  &kp F12    &trans        &trans        &kp LALT      &kp LGUI      &kp LCTRL
                     &kp LALT  &kp TAB  &kp SPACE  &trans        &trans        &trans
            >;
        };
    };
};
